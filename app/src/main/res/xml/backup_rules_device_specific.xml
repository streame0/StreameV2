<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Cloud backup rules (Android 12+ device-to-device transfer) -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="cache" path="." />
        <exclude domain="externalcache" path="." />
        <exclude domain="no_backup" path="." />
    </cloud-backup>
    <!-- Device-to-device transfer rules -->
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="cache" path="." />
        <exclude domain="externalcache" path="." />
        <exclude domain="no_backup" path="." />
    </device-transfer>
</data-extraction-rules>
